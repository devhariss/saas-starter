    "lucide-react": "^0.473.0",
    "next": "15.3.8",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "recharts": "^2.15.3",
    "resend": "^4.5.1",
    "stripe": "^17.7.0",
