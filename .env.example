# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SaasStarter

# ─────────────────────────────────────────────
# Database (PostgreSQL — Neon/Supabase compatible)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/saas_starter?sslmode=require

# ─────────────────────────────────────────────
# Auth (NextAuth v5 / Auth.js)
# ─────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────
# OAuth Providers
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_ID=
GITHUB_SECRET=

# ─────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRO_PRICE_ID=price_
STRIPE_TEAM_PRICE_ID=price_

# ─────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=noreply@yourcompany.com

# ─────────────────────────────────────────────
# Consent logging
# ─────────────────────────────────────────────
# Random string used as salt for IP hashing (SHA-256)
CONSENT_LOG_SALT=

# ─────────────────────────────────────────────
# Analytics (only loaded after consent)
# ─────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
